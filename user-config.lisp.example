;;;; user-config.lisp - User Configuration
;;;;
;;;; This file is loaded before layers are initialized.
;;;; Use it to customize your SBCL environment.
;;;;
;;;; To use this file, copy it to user-config.lisp:
;;;;   cp user-config.lisp.example user-config.lisp

(in-package #:sbcl-config)

;;; ============================================================================
;;; Layer Configuration
;;; ============================================================================

